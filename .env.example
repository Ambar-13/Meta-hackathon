# apps/api (apiEnv)
DATABASE_URL_API=postgres://app_api:change-me@localhost:5432/meet_first
APP_ORIGIN=http://localhost:3000
PORT=3000
MAX_CONCURRENT_MEETINGS=40
DATABASE_DISK_BYTES=1000000000
LOG_LEVEL=info

# apps/worker (workerEnv)
DATABASE_URL_WORKER=postgres://app_worker:change-me@localhost:5432/meet_first
META_API_KEY=replace-me
META_API_BASE_URL=https://api.meta.ai/v1
LLM_MODE=replay
DAILY_USD_CAP=40
TOTAL_USD_CAP=130

# pnpm db:migrate (migrateEnv)
DATABASE_URL_MIGRATE=postgres://app_migrate:change-me@localhost:5432/meet_first

# tests that need Postgres (packages/db/src/testing/fresh-database.ts). DATABASE_URL_ADMIN is a superuser of the
# local Postgres on its maintenance database; the tests make the four roles and the test databases through it.
DATABASE_URL_ADMIN=postgres://postgres:change-me@localhost:5432/postgres
DATABASE_URL_TEST=postgres://app_migrate:change-me@localhost:5432/meet_first_test
