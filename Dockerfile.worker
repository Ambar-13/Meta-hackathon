# Node 22 by base image. The worker is the only importer of packages/llm.
FROM node:22-bookworm-slim
# pnpm through corepack, installed at build time where the runtime user can read it (see Dockerfile.api).
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable
WORKDIR /app
COPY . .
# sharp installs its prebuilt glibc binary here; the image needs no compiler (item 35).
RUN corepack install && pnpm install --frozen-lockfile
ENV NODE_ENV=production
USER node
WORKDIR /app/apps/worker
# D71: the worker asserts the schema version at boot and exits otherwise; D74: it refuses LLM_MODE=replay in production. It runs as
# TypeScript through tsx, the way pnpm start runs it (as-built item 38).
CMD ["node", "--import", "tsx", "src/runner.ts"]
