# The one Render service (render.yaml). The same build as Dockerfile.api, the whole workspace with the web build (D72, A7), but
# it starts as root, so that scripts/start-api-and-worker.sh can run the api and the worker as two users of their own. Neither
# user can read the other's environment or the start script's, so the api never reaches the Meta key or the
# app_migrate URL; the start script itself keeps no rights it does not need once both have started.
FROM node:22-bookworm-slim
# pnpm through corepack, installed at build time where both users can read it (see Dockerfile.api).
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable
WORKDIR /app
COPY . .
RUN corepack install && pnpm install --frozen-lockfile
RUN pnpm --filter @meet-first/web build
# The two users, with no login shell, and each with a home and a temporary folder only it can write, so neither can plant a
# module or a compiled file the other would load. setpriv, which the start script uses to become them, ships in this image.
RUN set -e; \
    for user in meet-api meet-worker; do \
      useradd --system --create-home --home-dir "/home/$user" --shell /usr/sbin/nologin "$user"; \
      install -d -o "$user" -g "$user" -m 700 "/home/$user/tmp"; \
      chown "$user:$user" "/home/$user"; \
      chmod 700 "/home/$user"; \
    done; \
    command -v setpriv
ENV NODE_ENV=production
CMD ["bash", "/app/scripts/start-api-and-worker.sh"]
