# D72: Node 22 comes from this base image, because Render's own Node pick is unverified.
# A7: the api image also holds the web build, so there is one origin and one cookie.
FROM node:22-bookworm-slim
# The pnpm version comes from the packageManager field in package.json, through corepack. It is installed at build time into a
# folder the runtime user can read, so neither the pre-deploy migrate nor the start downloads pnpm.
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable
WORKDIR /app
COPY . .
RUN corepack install && pnpm install --frozen-lockfile
# The web app is the one part with a build step. The api and every package run as TypeScript through tsx, the way pnpm start runs
# them (as-built item 38), so there is no dist folder, and the dev dependencies, tsx among them, stay in the image.
RUN pnpm --filter @meet-first/web build
ENV NODE_ENV=production
USER node
WORKDIR /app/apps/api
# Render sets PORT; the api reads it through apiEnv (D73). D71: the pre-deploy command in render.yaml runs pnpm db:migrate in this image first.
CMD ["node", "--import", "tsx", "src/server.ts"]
